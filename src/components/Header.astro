---
import { nav } from "../site";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 h-(--header-height) border-b border-transparent transition-[background-color,border-color] duration-300 data-scrolled:border-rule data-scrolled:bg-paper/85 data-scrolled:backdrop-blur-md"
>
  <div class="page flex h-full items-center justify-between gap-6">
    <a href="/" class="group flex items-baseline gap-1.5 text-ink no-underline" aria-label="Morgan Stovold, home">
      <span class="font-serif text-[1.35rem] tracking-tight">Morgan Stovold</span>
      <span class="size-1.5 rounded-full bg-signal transition-transform group-hover:scale-150"></span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm text-ink-2 no-underline transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a
        href="/#contact"
        class="hidden rounded-full bg-ink px-4 py-2 text-sm text-paper no-underline transition-colors hover:bg-signal sm:inline-block"
      >
        Start a project
      </a>
      <button
        type="button"
        data-menu-button
        class="grid size-9 place-items-center rounded-full border border-rule md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 8h16M4 16h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    data-menu
    hidden
    class="border-b border-rule bg-paper md:hidden"
    aria-label="Mobile"
  >
    <ul class="page flex flex-col py-4">
      {
        nav.map((item) => (
          <li class="border-b border-rule last:border-0">
            <a href={item.href} class="block py-4 font-serif text-2xl text-ink no-underline">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]")!;
  const menu = document.querySelector<HTMLElement>("[data-menu]")!;

  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 12 || !menu.hidden);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    onScroll();
  };
  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  for (const link of menu.querySelectorAll("a")) link.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => event.key === "Escape" && setOpen(false));
</script>

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-full border border-rule text-ink-2 transition-colors hover:border-ink hover:text-ink"
  aria-label="Toggle dark mode"
>
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke-linejoin="round"></path>
  </svg>
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

  // The head script set the starting theme; keep following the system until the visitor picks one.
  systemDark.addEventListener("change", (event) => {
    try {
      if (localStorage.getItem("theme")) return;
    } catch {}
    root.dataset.theme = event.matches ? "dark" : "light";
  });

  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>

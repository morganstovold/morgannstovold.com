---
interface Props {
  number: string;
  label: string;
  class?: string;
}

const { number, label, class: className } = Astro.props;
---

<div class:list={["reveal flex items-center gap-4 border-t border-ink pt-4", className]}>
  <span class="label text-signal!">{number}</span>
  <span class="label">{label}</span>
</div>

# Contact form: messages are sent through https://resend.com (stovold.dev is the verified sending domain)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Morgan Stovold <website@stovold.dev>"
CONTACT_TO_EMAIL=morgan@stovold.dev

# GitHub activity section: optional. stacks/github.ts provisions it for CI from your Alchemy GitHub login,
# and local dev falls back to that same login, so you normally leave this unset.
# GH_ACTIVITY_TOKEN=
